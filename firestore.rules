rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms collection: public read, authenticated create/update
    match /rooms/{roomId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Bookings collection: read/write by booking participants or admin
    match /bookings/{bookingId} {
      allow read, write: if request.auth != null;
    }

    // Roommates collection: public read, owner write
    match /roommates/{profileId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // User profiles & activity
    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    // Disputes collection
    match /disputes/{disputeId} {
      allow read, write: if request.auth != null;
    }

    // Moderation audit logs collection: accessible by admin
    match /moderation_logs/{logId} {
      allow read, write: if true;
    }

    // Notifications collection: real-time FCM & in-app push notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
  }
}
